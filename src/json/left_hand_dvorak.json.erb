  {
      <%
      optional_modifiers = ["caps_lock","left_command","left_control","left_alt","right_command","right_control","right_alt"]
      number_keycodes = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"].map{|k| char_to_option(k)}.map{|k| k[:key_code]}
      froms = [
        "`", "1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "=",
        "q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "[", "]", "\\",
        "a", "s", "d", "f", "g", "h", "j", "k", "l", ";", "'",
        "z", "x", "c", "v", "b", "n", "m", ",", ".", "/",

        "~", "!", "@", "#", "$", "%", "^", "&", "*", "(", ")", "_", "+",
        "Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P", "{", "}", "|",
        "A", "S", "D", "F", "G", "H", "J", "K", "L", ":", '"',
        "Z", "X", "C", "V", "B", "N", "M", "<", ">", "?",
      ].map{|k| char_to_option(k)}
      toes  = [
        "`", "[", "]", "/", "p", "f", "m", "l", "j", "4", "3", "2", "1",
        ";", "q", "b", "y", "u", "r", "s", "o", ".", "6", "5", "=", "\\",
        "-", "k", "c", "d", "t", "h", "e", "a", "z", "8", "7",
        "'", "x", "g", "v", "w", "n", "i", ",", "9", "0",

        "~", "{", "}", "?", "P", "F", "M", "L", "J", "$", "#", "@", "!",
        ":", "Q", "B", "Y", "U", "R", "S", "O", ">", "^", "%", "+", "|",
        "_", "K", "C", "D", "T", "H", "E", "A", "Z", "*", "&",
        '"', "X", "G", "V", "W", "N", "I", "<", "(", ")",
      ].map{|k| char_to_option(k)}
      keys  = [froms, toes].transpose
      manipulators  = []

      manipulators += keys.map{|k|
        input  = k[0]
        output = k[1]
        default_optional_modifiers = (number_keycodes.include? input[:key_code]) ? [] : ["caps_lock"]
        {
          type: "basic",
          from: _from(
            input[:key_code],
            input[:modifiers] || [],
            input[:optional_modifiers] || default_optional_modifiers,
          ),
          to:   _to(
            [
              [output[:key_code], output[:modifiers]]
            ]
          ),
          conditions: [
            {
              type: "device_unless",
              identifiers: [
                {
                  product_id: 36897,
                  vendor_id: 11720,
                },
              ]
            },
            {
                "type": "frontmost_application_unless",
                "bundle_identifiers": ["^com\\.microsoft\\.rdc\\.macos$"]
            }
          ]
        }
      }
    %>
  "title": "Left Hand Dvorak Keyboard",
  "rules": [
    {
      "description": "Remap keys to use Left Hand Dvorak keyboard layout",
      "manipulators":
      <%= JSON.generate(manipulators) %>
    }
  ]
}
